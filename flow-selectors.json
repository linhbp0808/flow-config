{
  "version": "2.1.0",
  "updatedAt": "2026-05-31",
  "_comment": "Flow Studio remote selectors. v2.1: thêm khối 'gemini' (selector cho gemini.google.com) — khi Google đổi DOM chỉ cần sửa file này rồi push, không phải build lại tiện ích.",

  "panel": {
    "qtyRegex": "x[1-4]|[1-4]x",
    "iconKeywords": ["crop_", "aspect_ratio"],
    "modeKeywords": ["Video", "Hình", "Image"]
  },

  "modeTabs": {
    "image": { "texts": ["Hình ảnh", "Image", "Images"], "icons": ["image"] },
    "video": { "texts": ["Video", "Videos"], "icons": ["play_circle", "movie", "videocam"] }
  },

  "tiles": {
    "outputItems": "[data-tile-id]",
    "tileById": "[data-tile-id=\"{tileId}\"]",
    "tileEditLink": "[data-tile-id=\"{tileId}\"] a[href*=\"/edit/\"]",
    "editLinkAny": "a[href*=\"/edit/\"]",
    "completedVideo": "video[src]",
    "completedImage": "img[src]:not([src*=\"svg\"])",
    "buttonVideo": "button video[src]"
  },

  "skeletons": {
    "containers": "div.bqNkKb, div[class*=\"sc-55ebc859-2\"]",
    "parentWrapper": "div[class*=\"sc-55ebc859-0\"]",
    "legacyProgress": "div.bqNkKb > div, div.sc-55ebc859-2 > div, div.sc-55ebc859-7"
  },

  "submitButton": {
    "classSelector": "button.sc-e5032833-5",
    "composerClasses": [".sc-e5032833-0", "[class*=\"sc-e5032833\"]"],
    "iconSelector": "button i.google-symbols, button i, button span"
  },

  "fileUpload": {
    "buttonSelectors": [
      "div[class*=\"sc-84e494b2\"] > button",
      ".hyuxjz button",
      ".ckCGSv > button"
    ]
  },

  "editor": {
    "promptCaret": "#__next > div > div > div > div > div > div",
    "slateVerify": "p[data-slate-node=\"element\"] span[data-slate-string=\"true\"]",
    "editorSelectors": [
      "[data-slate-editor=\"true\"][contenteditable=\"true\"]",
      "[role=\"textbox\"][contenteditable=\"true\"]",
      "[role=\"textbox\"]",
      "div[contenteditable]"
    ]
  },

  "gemini": {
    "_comment": "Selector cho gemini.google.com. Khi Gemini đổi DOM, chỉ sửa các mảng dưới đây. Thứ tự trong mảng = ưu tiên thử trước.",
    "newChatUrl": "https://gemini.google.com/app",
    "editorSelectors": [
      ".ql-editor[role=\"textbox\"]",
      ".ql-editor",
      "[contenteditable=\"true\"][role=\"textbox\"]",
      "[contenteditable=\"true\"]",
      "textarea"
    ],
    "sendButtonSelectors": [
      "button.send-button",
      "[aria-label*=\"Send\"]",
      "[aria-label*=\"Gửi\"]"
    ],
    "stopSelectors": [
      "[data-mat-icon-name=\"stop\"]",
      "[fonticon=\"stop\"]",
      "mat-icon[fonticon=\"stop\"]",
      "button.send-button.stop",
      "[aria-label*=\"Stop\"]",
      "[aria-label*=\"Dừng\"]",
      "[class*=\"stop-button\"]"
    ],
    "doneFooterSelectors": [
      "message-actions",
      ".response-container-footer",
      "[data-test-id=\"copy-button\"]",
      "[data-test-id=\"regenerate-button\"]",
      "[data-test-id=\"thumb-up-button\"]",
      "copy-button"
    ],
    "turnSelectors": [
      "model-response",
      ".model-response-text",
      "message-content",
      "[class*=\"model-response\"]"
    ],
    "codeBlockSelectors": [
      "code-block",
      "pre code",
      ".code-block code"
    ],
    "uploadDropSelectors": [
      ".input-area",
      ".text-input-field",
      ".ql-editor",
      "[contenteditable=\"true\"]"
    ],
    "thumbnailSelector": "[class*=\"file\"] img, [class*=\"upload\"] img, [class*=\"attachment\"] img, [class*=\"preview\"] img, [class*=\"thumbnail\"] img, [class*=\"chip\"] img"
  },

  "scroller": {
    "primary": "[data-virtuoso-scroller]",
    "fallbacks": ["[class*=\"virtuoso\"]", "main", "[class*=\"sc-8rc14b4\"]", "[role=\"main\"]"]
  },

  "icons": {
    "submitArrow": ["arrow_forward", "send"],
    "addImage": ["add_2", "add"],
    "download": ["download"],
    "modelDropdown": ["arrow_drop_down", "expand_more"],
    "cropAspect": ["crop_landscape", "crop_portrait", "crop_square", "crop_16_9", "crop_9_16"]
  },

  "imagePicker": {
    "tabKeywords": ["Hình ảnh", "image", "images", "photo", "media", "asset"]
  },

  "searchInput": {
    "placeholders": [],
    "fallbackSelectors": [
      "[role=\"dialog\"] input[placeholder*=\"Tìm\"]",
      "[role=\"dialog\"] input[placeholder*=\"Search\"]",
      "[role=\"dialog\"] input",
      "[aria-modal=\"true\"] input[placeholder*=\"Tìm\"]",
      "[aria-modal=\"true\"] input[placeholder*=\"Search\"]",
      "[aria-modal=\"true\"] input",
      "[class*=\"popover\"] input[placeholder*=\"Tìm\"]",
      "[class*=\"popover\"] input[placeholder*=\"Search\"]",
      "[class*=\"popover\"] input",
      "[class*=\"modal\"] input",
      "[class*=\"picker\"] input",
      "input[placeholder*=\"voice\"]",
      "input[placeholder*=\"giọng\"]"
    ]
  },

  "pickerDialog": {
    "containers": ["[role=\"dialog\"]", "[aria-modal=\"true\"]", "[class*=\"modal\"]", "[class*=\"popover\"]", "[class*=\"picker\"]"]
  },

  "links": {
    "upgradePrompt": "http://localhost:8765"
  },

  "contacts": [
    { "label": "Telegram nhóm", "url": "https://t.me/Flowstudiobatchmanager" },
    { "label": "Discord", "url": "https://discord.com/invite/WH2csC6ut3" }
  ]
}
